<resources>


        <style name="RoundedImage" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">16dp</item> <!-- Adjust radius -->
        </style>
    <style name="Theme.Cinephile.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowLightStatusBar">true</item> <!-- Ensures light icons in the status bar -->
        <item name="android:windowBackground">@color/white</item> <!-- Default background color -->
    </style>
    <style name="RoundedTopCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerRadius">16dp</item> <!-- This will apply to all corners -->
 <!-- Explicit top right corner radius -->
    </style>
    <style name="CustomQueryTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#FFFFFF</item> <!-- White text -->
        <item name="android:textStyle">bold</item> <!-- Bold text -->
        <item name="android:textSize">16sp</item> <!-- Text size -->
    </style>

</resources>
